# OpenAI API (for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: load app credentials from AWS Secrets Manager before env fallbacks
BLUEGRASS_SECRET_ARN=
AWS_REGION=us-east-1

# xAI Grok API (for meme generation)
XAI_API_KEY=your_xai_api_key_here

# imgflip (for meme image rendering)
IMGFLIP_USERNAME=your_imgflip_username
IMGFLIP_PASSWORD=your_imgflip_password

# Reddit API (for niche discovery - optional)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Video ad pipeline
KLING_API_KEY=your_kling_api_key
# Legacy Kling auth fallback, only needed for older access/secret accounts
KLING_ACCESS_KEY=
KLING_SECRET=
# Backward-compatible video-only secret ARN; prefer BLUEGRASS_SECRET_ARN
KLING_SECRET_ARN=
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Instagram Graph API (for human-approved meme publishing)
META_IG_ACCESS_TOKEN=your_meta_instagram_access_token
META_IG_USER_ID=17841449649203293
META_APP_ID=1042489268787325
META_PAGE_ID=1370368009487261

# Life-ops tenant (default: config/tenant.yaml). Friend setup: copy
# config/tenant.example.yaml → config/tenant.yaml. See docs/life-ops.md.
# TENANT_CONFIG=config/tenant.yaml

# Spend project tag on token events (default: tenant defaults.usage_project).
# Other jobs: USAGE_PROJECT=waiver-wire  |  X-draft xAI calls: USAGE_PROJECT=x
USAGE_PROJECT=memes

# S3 bucket (public memes + private ops/queue and ops/usage)
MEME_ASSETS_BUCKET=bluegrass-meme-pipeline-dev-meme-assets
MEME_ASSETS_PUBLIC_BASE_URL=https://bluegrass-meme-pipeline-dev-meme-assets.s3.amazonaws.com
# Generated JPEGs default to public/memes/generated/. Templates stay at public/memes/templates/.
# MEME_ASSETS_PUBLIC_PREFIX=public/memes/generated/
AWS_DEFAULT_REGION=us-east-1
