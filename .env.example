# OpenAI API (for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: load app credentials from AWS Secrets Manager before env fallbacks
BLUEGRASS_SECRET_ARN=
AWS_REGION=us-east-1

# xAI Grok API (for meme generation)
XAI_API_KEY=your_xai_api_key_here

# imgflip (for meme image rendering)
IMGFLIP_USERNAME=your_imgflip_username
IMGFLIP_PASSWORD=your_imgflip_password

# Reddit API (for niche discovery - optional)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Video ad pipeline
KLING_API_KEY=your_kling_api_key
# Legacy Kling auth fallback, only needed for older access/secret accounts
KLING_ACCESS_KEY=
KLING_SECRET=
# Backward-compatible video-only secret ARN; prefer BLUEGRASS_SECRET_ARN
KLING_SECRET_ARN=
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Instagram Graph API (for human-approved meme publishing)
META_IG_ACCESS_TOKEN=your_meta_instagram_access_token
META_IG_USER_ID=17841449649203293
META_APP_ID=1042489268787325
META_PAGE_ID=1370368009487261
